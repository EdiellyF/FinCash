PORT=5000
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/fincash?schema=public"
JWT_SECRET="change_this_secret"
FRONTEND_URL="http://localhost:5173"

# Gemini (opcional - 20 requisições por dia global)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (opcional - ilimitado, usado após limite do Gemini)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
