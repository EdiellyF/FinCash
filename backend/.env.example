PORT=5000
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/fincash?schema=public"
JWT_SECRET="change_this_secret"
FRONTEND_URL="http://localhost:5173"

# GROQ API (100 requisições por dia global, 20 por usuário)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY="gsk_seu_groq_api_key_aqui"

# Gemini API (20 requisições por dia global, 2 por usuário)
# Obtenha em: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY="sua_gemini_api_key_aqui"

# Ollama (opcional - ilimitado, usado como fallback)
OLLAMA_API_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
