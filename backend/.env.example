PORT=5000
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/fincash?schema=public"
JWT_SECRET="change_this_secret"
FRONTEND_URL="http://localhost:5173"

# OpenAI (opcional - usado até 50 requisições/dia)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama (opcional - usado após limite do OpenAI ou se não configurado)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
